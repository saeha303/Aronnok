# Copy this file to `.env` and fill in real values. Never commit `.env`.

# MongoDB connection string (e.g. a free MongoDB Atlas cluster)
DATABASE=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aronnok?retryWrites=true&w=majority

# Secret used to sign login tokens (any long random string)
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET=change-me

# Port for the local API server (`npm start`)
PORT=8000

# Public URL of the app. Payment gateway redirects come back here.
#   local dev: http://localhost:5173   production: https://<your-app>.vercel.app
APP_URL=http://localhost:5173

# Comma-separated origins allowed to call the API (only needed when the
# frontend is served from a different origin, e.g. during local dev)
CORS_ORIGINS=http://localhost:5173

# SSLCommerz sandbox credentials (https://developer.sslcommerz.com/registration/)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
